/-!
Current selected PR799 at f567: destination-only support witnesses for the two
forward scalar segments raw1..6488 and7219..9240, around the entry adapters.
The exact first climb-bearing block begins9241 and touches the retained16
registers. The destination tables and ordered run-length indices are independently
inverted against the selected source. No payload-state replay is evaluated.

Each typed-word destination-trace equality remains an explicit premise. The
second segment retains labels0/2/3 at source; label interpretation is not erased
from any claimed execution theorem. Sixteen entry adapters, including eight
residual pre wrappers at frame4, and residual-inverse/hstart remain separate.
Apache-2.0. Reuses accepted PR509/PR516 semantics and ScalarWriteSupport.
Prepared with OpenAI assistance.
-/
set_option Elab.async false
namespace CurrentMain.Current799ScalarSupport
open LemmaG LemmaG.Stream ScalarWriteSupport

def selectedSupport : List (Fin 736) := Historical596.first33Support
/-- A table entry carries its no-write proof once, independently of run length. -/
def SafeTarget := {i : Fin 736 // i ∉ selectedSupport}
private def defaultSafe : SafeTarget := ⟨⟨0, by decide⟩, by decide⟩

def expandSafeTargets (table : List SafeTarget) (runs : List (Nat × Nat)) :
    List (Fin 736) :=
  runs.flatMap fun r => List.replicate r.2 (table.getD r.1 defaultSafe).val

theorem expanded_targets_safe (table : List SafeTarget) (runs : List (Nat × Nat))
    (i : Fin 736) (hi : i ∈ expandSafeTargets table runs) : i ∉ selectedSupport := by
  obtain ⟨r, _, hm⟩ := List.mem_flatMap.mp hi
  have he : i = (table.getD r.1 defaultSafe).val := List.eq_of_mem_replicate hm
  rw [he]
  exact (table.getD r.1 defaultSafe).property

section Generic
variable {Λ K M : Type*} [Semiring K] [AddCommMonoid M] [Module K M]

def HasDestinationTrace (es : List (Event (Fin 736) Λ K))
    (table : List SafeTarget) (runs : List (Nat × Nat)) : Prop :=
  es.map LemmaA.dst = expandSafeTargets table runs

theorem interpreted_run_preserves_support (rec : Λ → Λ → M → M)
    (table : List SafeTarget) (runs : List (Nat × Nat))
    (es : List (Event (Fin 736) Λ K)) (htrace : HasDestinationTrace es table runs)
    (h : Fin 736 → M) (i : Fin 736) (hi : i ∈ selectedSupport) :
    physRun rec es h i = h i := by
  apply ScalarWriteSupport.physRun_unchanged
  intro e he
  have ht : LemmaA.dst e ∈ expandSafeTargets table runs := by
    rw [← htrace]
    exact List.mem_map.mpr ⟨e, he, rfl⟩
  have hn := expanded_targets_safe table runs (LemmaA.dst e) ht
  exact fun eq => hn (eq ▸ hi)
end Generic

