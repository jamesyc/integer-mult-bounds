section Applications
variable {Λ K M : Type*} [Semiring K] [AddCommMonoid M] [Module K M]

theorem forward_precondition_preserves_support (es : List (Event (Fin 736) Λ K))
    (htrace : HasDestinationTrace es preconditionTargets preconditionRuns)
    (h : Fin 736 → M) (i : Fin 736) (hi : i ∈ selectedSupport) :
    scalRun es h i = h i :=
  interpreted_run_preserves_support (fun _ _ v => v) _ _ es htrace h i hi

theorem forward_early_A_preserves_support (es : List (Event (Fin 736) Λ K))
    (htrace : HasDestinationTrace es earlyATargets earlyARuns)
    (h : Fin 736 → M) (i : Fin 736) (hi : i ∈ selectedSupport) :
    scalRun es h i = h i :=
  interpreted_run_preserves_support (fun _ _ v => v) _ _ es htrace h i hi
end Applications
end CurrentMain.Current799ScalarSupport

